  {
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "label_replace(max by (n) (label_replace((aiops_node_cpu_percent), \"n\", \"Node-$1\", \"node\", \"(?:DGX|Node)-(.*)\")), \"node\", \"$1\", \"n\", \"(.*)\")",
     "legendFormat": "{{node}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 60000,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "none"
      },
      "gradientMode": "none"
     },
     "color": {
      "mode": "shades",
      "fixedColor": "#3d7bf5"
     },
     "max": 100
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(DGX|Node)-1$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3d7bf5"
        }
       },
       {
        "id": "displayName",
        "value": "Node-1"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(DGX|Node)-2$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ee6420"
        }
       },
       {
        "id": "displayName",
        "value": "Node-2"
