{
 "uid": "aiops-fleet",
 "title": "Fleet",
 "description": "All four DGX Sparks: compute, memory, GPU, storage, network. Source: Spark Monitor via the platform exporter.",
 "tags": [
  "sovereign-ai-ops"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Nodes reporting",
   "description": "Nodes whose Spark Monitor answered the last scrape.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(aiops_node_up)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0"
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "Models ready",
   "description": "Model servers ready across the fleet.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(aiops_model_ready)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0"
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "Containers running",
   "description": "Docker containers running across the four nodes.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(aiops_containers{state=\"running\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0"
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "Failed services",
   "description": "Failed systemd units plus unhealthy containers.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(aiops_systemd_units_failed) + sum(aiops_containers_unhealthy)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
