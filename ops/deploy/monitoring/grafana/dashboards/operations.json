  {
   "type": "timeseries",
   "title": "Unhealthy containers + failed units",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "label_replace(max by (n) (label_replace((aiops_containers_unhealthy + on(node) aiops_systemd_units_failed), \"n\", \"Node-$1\", \"node\", \"(?:DGX|Node)-(.*)\")), \"node\", \"$1\", \"n\", \"(.*)\")",
     "legendFormat": "{{node}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 60000,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "none"
      },
      "gradientMode": "none"
     },
     "color": {
      "mode": "shades",
      "fixedColor": "#3d7bf5"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(DGX|Node)-1$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3d7bf5"
        }
       },
       {
        "id": "displayName",
        "value": "Node-1"
       }
      ]
     },
